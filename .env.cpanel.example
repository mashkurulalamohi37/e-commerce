# Build-time config for `npm run build:cpanel` (Vite --mode cpanel).
# Copy to `.env.cpanel` before building for production.
#
# Everything here is VITE_-prefixed, which means it is INLINED INTO THE PUBLIC
# BUNDLE. Never put a secret in this file.
#
# The API runs as a separate cPanel Python App on the api. subdomain, so the
# storefront talks to it cross-origin. These values must match
# BACKEND_CORS_ORIGINS in the backend's .env or every request fails CORS.

VITE_API_BASE_URL=https://api.nillsmart.com/api/v1
VITE_SITE_URL=https://nillsmart.com
