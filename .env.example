# Copy to .env and adjust. .env is git-ignored — never commit real credentials.
#
# The storefront is a thin client over the FastAPI service in backend/.
# Backend configuration lives in backend/.env (see backend/.env.example).

# Base URL of the FastAPI service, including the /api/v1 prefix.
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Canonical origin, used for absolute URLs in sitemap.xml.
# Leave unset in development; set it in production, e.g. https://nillsmart.com
VITE_SITE_URL=""

# --- Optional: PostHog analytics ---
# Unset means analytics are a no-op that logs to the console in development.
# VITE_POSTHOG_API_KEY=""
# VITE_POSTHOG_REGION="eu"
