# Secrets — never commit real credentials. Track .env.example instead.
.env
.env.*
!.env.example
!.env.cpanel.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
deploy-cpanel
nills_mart-cpanel.zip
*.zip
*.tar.gz
*.gz
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Admin-uploaded media. Runtime data, not source — and the test suite writes
# into the same directory, so test artifacts were being committed too.
backend/uploads/*
!backend/uploads/.gitkeep

# Python & SQLite
__pycache__/
*.pyc
venv/
.venv/
backend/venv/
backend/.venv/
*.sqlite3
*.db
backend/*.db

