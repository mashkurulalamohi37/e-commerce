# Backend environment for the Namecheap cPanel deployment.
#
# Copy to backend/.env on the server (or paste each line into cPanel > Setup
# Python App > Environment variables). This file must never be committed with
# real values in it -- .gitignore covers backend/.env, not this example.

PROJECT_NAME="Nills Mart E-Commerce API"
API_V1_STR="/api/v1"

# Turns on production behaviour: SECRET_KEY becomes mandatory rather than
# ephemeral, and the any-localhost-port CORS regex is switched off.
ENVIRONMENT="production"

# Generate a fresh one, do not reuse the development key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anyone holding this value can forge a valid admin JWT.
SECRET_KEY="PASTE_A_FRESHLY_GENERATED_KEY_HERE"

# 12 hours. The token is stored in localStorage where any XSS can read it, so
# the lifetime is the size of the exposure window.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite, because Namecheap shared hosting offers MySQL/MariaDB only -- there is
# no PostgreSQL. Use an ABSOLUTE path, and keep the file in the application root
# (outside public_html) so it is never served over HTTP. Substitute your cPanel
# username for USER.
#
# Caveat: Passenger runs several worker processes against this one file, so
# concurrent writes serialise and a heavy write burst can raise "database is
# locked". Fine for a launch-scale store; see DEPLOY_NAMECHEAP.md if you outgrow it.
DATABASE_URL="sqlite+aiosqlite:////home/USER/nillsmart-api/ecommerce.db"

# Exact origins the browser sends. allow_credentials is on, so a wildcard is not
# accepted. These must match what the storefront was built with in .env.cpanel.
BACKEND_CORS_ORIGINS=["https://nillsmart.com","https://www.nillsmart.com"]

# Used to build password-reset links in outgoing mail.
FRONTEND_URL="https://nillsmart.com"

# Absolute path keeps uploads working regardless of Passenger's working directory.
UPLOAD_DIR="/home/USER/nillsmart-api/uploads"
MAX_UPLOAD_SIZE_MB=10

# Outbound SMTP. Shared hosts commonly block connections to third-party SMTP
# ports; if mail silently fails, switch to the Namecheap Private Email host or
# cPanel's local mail server rather than smtp.gmail.com.
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM="noreply@nillsmart.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_FROM_NAME="Nills Mart"
