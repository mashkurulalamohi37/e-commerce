PROJECT_NAME="Nills Mart E-Commerce API"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_random_hash_key_in_cpanel_env"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Connection
# Format: postgresql+asyncpg://username:password@localhost:5432/dbname
DATABASE_URL="postgresql+asyncpg://cpaneluser_dbuser:StrongPassword123!@localhost:5432/cpaneluser_ecommerce"

BACKEND_CORS_ORIGINS=["https://yourdomain.com", "http://localhost:5173"]

UPLOAD_DIR="uploads"
