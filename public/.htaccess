# Nills Mart storefront — Apache/LiteSpeed config for Namecheap shared hosting.
#
# This file lives in public/ so Vite copies it into the build output, and it
# lands in public_html/ when the build is uploaded. Do not add it to the upload
# by hand; it is part of the bundle.
#
# The API is NOT proxied here. It runs as a separate cPanel Python App on
# api.nillsmart.com, so the browser talks to it cross-origin and CORS on the
# FastAPI side is what authorises it.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. cPanel AutoSSL issues the certificate; until it has been
  # issued this redirect will hand visitors a browser warning, so run it only
  # after the certificate shows as active in cPanel > SSL/TLS Status.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: apex, not www.
  #
  # This matters more than usual here. The auth token lives in localStorage,
  # which is keyed per-origin, so if both www.nillsmart.com and nillsmart.com
  # stay reachable a customer who signs in on one appears signed out on the
  # other. Pick one. To make www canonical instead, swap this rule for the
  # inverse and update BACKEND_CORS_ORIGINS and FRONTEND_URL to match.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # SPA fallback. TanStack Router owns /checkout, /admin, /category/:slug and
  # the rest client-side. Apache has no such files on disk, so without this a
  # refresh or a shared deep link returns 404. Anything that does exist on
  # disk -- assets, uploads, favicons -- is served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vite fingerprints everything it emits into /assets/, so those URLs can be
  # cached forever.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images and static media (catalog photos, banners, favicons, logos)
  <FilesMatch "\.(png|jpe?g|webp|svg|gif|ico|avif)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # The shell references the hashed bundles by name. Cache it and a deploy
  # strands returning visitors on asset URLs that no longer exist.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# Directory listings would expose the upload structure.
Options -Indexes
